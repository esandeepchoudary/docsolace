{
  "name": "autodocs",
  "version": "1.0.0",
  "description": "Screenshot-driven docs for your app: a Claude Code plugin that drives your running app with Playwright and writes tutorials that stay in sync.",
  "main": "index.js",
  "scripts": {
    "capture": "node plugin/scripts/capture.mjs",
    "crawl": "node plugin/scripts/crawl.mjs",
    "generate-docs": "node plugin/scripts/generate-docs.mjs",
    "generate-product-docs": "node plugin/scripts/generate-product-docs.mjs",
    "drift": "node plugin/scripts/drift.mjs",
    "prune": "node plugin/scripts/prune.mjs",
    "archive-tour": "node plugin/scripts/archive-tour.mjs",
    "validate": "node plugin/scripts/validate.mjs",
    "status": "node plugin/scripts/status.mjs",
    "verify-docs": "node plugin/scripts/verify-docs.mjs",
    "review-diffs": "node plugin/scripts/review-diffs.mjs",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esandeepchoudary/autodocs.git"
  },
  "keywords": [
    "documentation",
    "documentation-generator",
    "docs-as-code",
    "claude-code",
    "claude-code-plugin",
    "anthropic",
    "playwright",
    "headless-browser",
    "screenshots",
    "screenshot-testing",
    "docusaurus",
    "technical-writing",
    "developer-tools",
    "automation",
    "nodejs",
    "ai-agents"
  ],
  "author": "esandeepchoudary",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/esandeepchoudary/autodocs/issues"
  },
  "homepage": "https://github.com/esandeepchoudary/autodocs#readme",
  "devDependencies": {
    "glob": "^13.0.6",
    "js-yaml": "^5.2.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
